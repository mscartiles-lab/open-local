# EAS archive exclusions (git root).
# IMPORTANT: When .easignore exists, EAS replaces ALL .gitignore rules with this
# file plus only "node_modules" and ".git" as defaults. Every path normally
# covered by .gitignore must be explicitly listed here.

# ── Workspace-level gitignored paths (no longer auto-excluded) ────────────────
.local
.cache
tmp
dist
.expo
.expo-shared
*.tsbuildinfo
out-tsc

# ── pnpm workspace files (prevent pnpm detection; yarn.lock in mobile dir wins) ──
pnpm-lock.yaml
pnpm-workspace.yaml

# ── Non-mobile workspace packages (mobile build only needs open-local-mobile/) ──
artifacts/api-server
artifacts/open-local
artifacts/mockup-sandbox

# ── Shared libraries (already vendored into artifacts/open-local-mobile/lib/) ──
lib

# ── Large asset/attachment directories not needed for native build ─────────────
attached_assets
docs
scripts
.agents

# ── IDE / editor artefacts ────────────────────────────────────────────────────
.idea
.vscode
